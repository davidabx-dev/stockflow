# Configurações Gerais
PROJECT_NAME=StockFlow
API_V1_STR=/api/v1

# Segredos Criptográficos (Gerar com secrets.token_urlsafe)
SECRET_KEY=change_this_secret_key_in_production_min_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Banco de Dados da Aplicação (Role com privilégios restritos)
DB_HOST=localhost
DB_PORT=5432
DB_USER=stockflow_user
DB_PASSWORD=your_secure_password_here
DB_NAME=stockflow_db

DATABASE_URL=postgresql+asyncpg://stockflow_user:your_secure_password_here@localhost:5432/stockflow_db
SYNC_DATABASE_URL=postgresql://stockflow_user:your_secure_password_here@localhost:5432/stockflow_db
TEST_DATABASE_URL=postgresql+asyncpg://stockflow_user:your_secure_password_here@localhost:5432/stockflow_db_test

# Banco de Dados para Migrações Administrativas (Owner DDL)
MIGRATION_DATABASE_URL=postgresql://stockflow_admin:your_secure_password_here@localhost:5432/stockflow_db

# Usuário Inicial de Seed (Admin)
FIRST_ADMIN_EMAIL=admin@stockflow.local
FIRST_ADMIN_PASSWORD=change_this_admin_password
FIRST_ADMIN_NOME=Administrador do Sistema
